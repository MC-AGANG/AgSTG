<UserControl x:Class="Stage2bg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Stage2"
             mc:Ignorable="d" 
             d:DesignHeight="448" d:DesignWidth="384"
             Loaded="UserControl_Loaded">
    <Grid>
        <Rectangle Fill="Black" Name="BB"></Rectangle>

        <Canvas Name="ParticleLayer" Opacity="0.5" ClipToBounds="True" >
            <Canvas.Effect>
                <BlurEffect Radius="2"/>
            </Canvas.Effect>
        </Canvas>

        <Viewport3D>


            <Viewport3D.Camera>
                <PerspectiveCamera
        Position="0,2,0"
        LookDirection="8,-1,0"
        FieldOfView="35"
        UpDirection="0,1,0"
        x:Name="camera">
                    <PerspectiveCamera.Transform>
                        <RotateTransform3D>
                            <RotateTransform3D.Rotation>
                                <AxisAngleRotation3D x:Name="camera_rotate" Axis="1,0,0" Angle="0"/>
                            </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#FFFFFF" x:Name="Light"/>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D 
                        Positions="
                        0,0,-4 0,0,4 8,0,-4 8,0,4
                        "
                        TextureCoordinates="
                        0,1 1,1 0,0 1,0
                        "
                        TriangleIndices="
                        0 3 2 0 1 3
                        "/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial x:Name="t1" Brush="Magenta"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D 
                        Positions="
                        8,0,-4 8,0,4 16,0,-4 16,0,4
                        "
                        TextureCoordinates="
                        0,1 1,1 0,0 1,0
                        "
                        TriangleIndices="
                        0 3 2 0 1 3
                        "/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial x:Name="t2" Brush="Magenta"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D 
                        Positions="
                        16,0,-4 16,0,4 24,0,-4 24,0,4
                        "
                        TextureCoordinates="
                        0,1 1,1 0,0 1,0
                        "
                        TriangleIndices="
                        0 3 2 0 1 3
                        "/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial x:Name="t3" Brush="Magenta"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D 
                        Positions="
                        24,0,-4 24,0,4 32,0,-4 32,0,4
                        "
                        TextureCoordinates="
                        0,1 1,1 0,0 1,0
                        "
                        TriangleIndices="
                        0 3 2 0 1 3
                        "/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial x:Name="t4" Brush="Magenta"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
        
        <Rectangle Name="RC_Sky"/>
        <Viewport3D Name="VP_Particle" Opacity="0.3">
            <Viewport3D.Effect>
                <BlurEffect Radius="8"/>
            </Viewport3D.Effect>
            <Viewport3D.Camera>
                <PerspectiveCamera
    Position="0,0,0"
    LookDirection="1,0.0001,0"
    FieldOfView="60"
    UpDirection="0,1,0"
    x:Name="camera_particle">
                </PerspectiveCamera>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup x:Name="Particle3DLayer">
                        <AmbientLight Color="#80A0A0" x:Name="Light_particle"/>

                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
        <Rectangle Name="FW">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#7F808080" Offset="0.712"/>
                    <GradientStop Color="#00808080" Offset="0.843"/>
                    <GradientStop Color="#3FD3D3D3" Offset="0.329"/>
                    <GradientStop Color="#14808080" Offset="0"/>
                    <GradientStop Color="#7F808080" Offset="0.607"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Name="FY" Visibility="Hidden">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#BFFFFC89"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>

        </Rectangle>
        <Canvas Name="cardback" x:FieldModifier="public" Visibility="Hidden" ClipToBounds="True">
            <Rectangle Name="CB1" Width="384" Height="448" Canvas.Top="0"/>
            <Rectangle Name="CB2" Width="384" Height="448" Canvas.Top="448"/>
        </Canvas>
    </Grid>
</UserControl>

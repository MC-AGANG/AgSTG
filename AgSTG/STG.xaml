<UserControl x:Class="STG"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AgSTG"
             xmlns:ps="clr-namespace:wpfpslib;assembly=wpfpslib"
             mc:Ignorable="d" 
             d:DesignHeight="448" d:DesignWidth="384"
             ClipToBounds="True"
             Loaded="UserControl_Loaded">
    <UserControl.RenderTransform>
        <TransformGroup>
            <TranslateTransform x:Name="me_translate"/>
        </TransformGroup>
    </UserControl.RenderTransform>
    <UserControl.Effect>
        <BlurEffect x:Name="Me_Blur" Radius="0"/>
    </UserControl.Effect>
    <Grid>
        <Grid Name="BL">
            <Grid.Effect>
                <ps:BlackHoleEffect Dist="0.5" Aspectratio="1.1667" x:Name="BL_BH" Radius="0"/>
            </Grid.Effect>
        </Grid>
        <Canvas Name="mb">

        </Canvas>
        <Canvas Height="16" Width="60" VerticalAlignment="Top" Margin="0,8,0,0" Name="timearea" Visibility="Hidden">
            <Rectangle Name="time10" Height="16" Width="16" Canvas.Left="0"></Rectangle>
            <Rectangle Name="time1" Height="16" Width="16" Canvas.Left="12"></Rectangle>
            <Rectangle Name="time0" Height="16" Width="16" Canvas.Left="24"></Rectangle>
            <Rectangle Name="time01" Height="16" Width="16" Canvas.Left="36"></Rectangle>
            <Rectangle Name="time001" Height="16" Width="16" Canvas.Left="48"></Rectangle>
        </Canvas>
        <local:DialogArea x:Name="DA" Visibility="Hidden"/>
        <local:CardLabel x:Name="SA"/>
        <Rectangle Name="RC_Title" Height="128" Width="256" Margin="64,80,64,240" Opacity="0"></Rectangle>
        <Label Name="LB_Music" Height="32" Width="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="16" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Right" Padding="0,0,8,0" Foreground="White" Margin="0,0,-320,0">
            <Label.Effect>
                <DropShadowEffect Color="Black" ShadowDepth="2" Opacity="1" BlurRadius="0"/>
            </Label.Effect>
        </Label>
        <local:BossName Height="16" Width="80" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Hidden" x:Name="BN">
            
        </local:BossName>
    </Grid>
</UserControl>

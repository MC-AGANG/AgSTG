<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>TH07</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgSTG.Controls\AgSTG.Controls.vbproj" />
    <ProjectReference Include="..\AgSTG.Core\AgSTG.Core.vbproj" />
    <ProjectReference Include="..\AgSTG\AgSTG.vbproj" />
    <ProjectReference Include="..\ResourcePack.TH07\ResourcePack.TH07.vbproj" />
    <ProjectReference Include="..\ResourcePack\ResourcePack.vbproj" />
    <ProjectReference Include="..\Stage1\Stage1.vbproj" />
    <ProjectReference Include="..\Stage2\Stage2.vbproj" />
    <ProjectReference Include="..\Stage3\Stage3.vbproj" />
    <ProjectReference Include="..\Stage4\Stage4.vbproj" />
    <ProjectReference Include="..\Stage5\Stage5.vbproj" />
    <ProjectReference Include="..\Stage6\Stage6.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ManagedBass">
      <HintPath>..\dll\Bass\ManagedBass.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="bass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<UserControl x:Class="Stage4bg"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Stage4"
             mc:Ignorable="d" 
             d:DesignHeight="448" d:DesignWidth="384"
             Loaded="UserControl_Loaded">
    <Grid Background="Black">
        <Canvas ClipToBounds="True">
            <Rectangle Name="RC_vortex" Height="600" Width="600" Canvas.Left="-108" Canvas.Top="-76">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="Rotate_vortex" CenterX="300" CenterY="300"/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>
        <Viewport3D Name="VP3D" Visibility="Hidden" Opacity="0">


            <Viewport3D.Camera>
                <PerspectiveCamera
        Position="0,2,0"
        LookDirection="2,-1,0"
        FieldOfView="35"
        UpDirection="0,1,0"
        x:Name="camera">
                    <PerspectiveCamera.Transform>
                        <RotateTransform3D>
                            <RotateTransform3D.Rotation>
                                <AxisAngleRotation3D x:Name="camera_rotate" Axis="1,0,0" Angle="0"/>
                            </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#FFFFFF" x:Name="Light"/>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D 
Positions="
12,0,-4 12,0,4 20,0,-4 20,0,4
"
TextureCoordinates="
0,1 1,1 0,0 1,0
"
TriangleIndices="
0 3 2 0 1 3
"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial x:Name="t4" Brush="Magenta"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D 
Positions="
8,0.01,-4 8,0.01,4 16,0.01,-4 16,0.01,4
"
TextureCoordinates="
0,1 1,1 0,0 1,0
"
TriangleIndices="
0 3 2 0 1 3
"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial x:Name="t3" Brush="Magenta"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D 
Positions="
4,0.02,-4 4,0.02,4 12,0.02,-4 12,0.02,4
"
TextureCoordinates="
0,1 1,1 0,0 1,0
"
TriangleIndices="
0 3 2 0 1 3
"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial x:Name="t2" Brush="Magenta"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D 
Positions="
0,0.03,-4 0,0.03,4 8,0.03,-4 8,0.03,4
"
TextureCoordinates="
0,1 1,1 0,0 1,0
"
TriangleIndices="
0 3 2 0 1 3
"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial x:Name="t1" Brush="Magenta"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
        <Rectangle Name="RC_Sky" Height="256" VerticalAlignment="Top" Opacity="0"/>
        <Canvas Name="ParticleLayer" Opacity="0" ClipToBounds="True">
            <Canvas.Effect>
                <BlurEffect Radius="3"/>
            </Canvas.Effect>
        </Canvas>
    </Grid>
</UserControl>
